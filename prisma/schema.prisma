generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Если пишет ошибку, то это из-за того, что IDE проверяет код по другой версии prisma (запускается и ладно)
  url      = env("DATABASE_URL")
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum HistoryRole {
  HOST
  PLAYER
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  email        String @unique
  passwordHash String

  quizzes Quiz[]
  players Player[]
  rooms   Room[]
  history GameHistory[]

  createdAt DateTime @default(now())
}

model Quiz {
  id               Int     @id @default(autoincrement())
  title            String
  category         String?
  rules            String?
  defaultTimeLimit Int     @default(20)
  ownerId          Int

  owner     User          @relation(fields: [ownerId], references: [id])
  questions Question[]
  rooms     Room[]
  history   GameHistory[]

  createdAt DateTime @default(now())
}

model Question {
  id       Int     @id @default(autoincrement())
  text     String
  imageUrl String?

  type QuestionType @default(SINGLE)

  optionA String
  optionB String
  optionC String
  optionD String

  correctAnswer String
  timeLimit     Int

  quizId Int
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers Answer[]

  order     Int      @default(1)
  createdAt DateTime @default(now())
}

model Room {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  quizId            Int
  hostId            Int
  isStarted         Boolean   @default(false)
  finished          Boolean   @default(false)
  currentQuestion   Int       @default(0)
  questionStartedAt DateTime?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  host    User     @relation(fields: [hostId], references: [id])
  players Player[]

  createdAt DateTime @default(now())
}

model Player {
  id       Int    @id @default(autoincrement())
  nickname String
  score    Int    @default(0)

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  answers  Answer[]
  socketId String?

  createdAt DateTime @default(now())

  @@unique([roomId, nickname])
}

model Answer {
  id         Int      @id @default(autoincrement())
  playerId   Int
  questionId Int
  answer     String
  isCorrect  Boolean
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model GameHistory {
  id Int @id @default(autoincrement())

  userId Int
  quizId Int

  quizTitle String
  role      HistoryRole

  roomCode String
  score    Int
  place    Int

  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}
